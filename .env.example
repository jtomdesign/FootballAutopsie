# Supabase project (publishable key is safe to expose — RLS enforces access)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# API-Football key — works with either provider:
#  - api-sports.io (direct):   host = v3.football.api-sports.io, header x-apisports-key
#  - RapidAPI:                 host = api-football-v1.p.rapidapi.com (default), header x-rapidapi-key
VITE_FOOTBALL_API_KEY=

# Uncomment to use api-sports.io directly instead of RapidAPI:
# VITE_FOOTBALL_API_HOST=v3.football.api-sports.io

# Google AdSense ad unit slot IDs (from AdSense → Ads → By ad unit).
# Leave empty to show placeholders instead of ad units.
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_RECTANGLE=
